IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "uart_tx" U15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC "uart_rx" V14;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// PMOD0: each adjacent Sipeed IO pair is one Wii extension I2C bus.
// Digilent pins 1-4 carry SCL; 7-10 carry SDA. Outputs only pull low.
IO_LOC "pmod0[0]" V18;
IO_LOC "pmod0[1]" V19;
IO_LOC "pmod0[2]" G21;
IO_LOC "pmod0[3]" G22;
IO_LOC "pmod0[4]" F18;
IO_LOC "pmod0[5]" E18;
IO_LOC "pmod0[6]" C22;
IO_LOC "pmod0[7]" B22;
IO_PORT "pmod0[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "pmod0[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "pmod0[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "pmod0[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "pmod0[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "pmod0[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "pmod0[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "pmod0[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Pmod I2S2 on PMOD1, seated normally: Digilent pins 1-4 are Sipeed
// PMOD1_IO0, IO2, IO4 and IO6 (PMOD-001), the DAC's MCLK, LRCK, SCLK and
// SDIN (Tang-Phosphor docs/i2s2-bringup.md).
IO_LOC "pmod1_dac[0]" W19;
IO_LOC "pmod1_dac[1]" F19;
IO_LOC "pmod1_dac[2]" E22;
IO_LOC "pmod1_dac[3]" E21;
IO_PORT "pmod1_dac[0]" IO_TYPE=LVCMOS33;
IO_PORT "pmod1_dac[1]" IO_TYPE=LVCMOS33;
IO_PORT "pmod1_dac[2]" IO_TYPE=LVCMOS33;
IO_PORT "pmod1_dac[3]" IO_TYPE=LVCMOS33;

// The AE350 has a dedicated core-clock connection at this PLL site.
INS_LOC "cpu_pll" PLL_R[0];

// Dock connector J9 (SDRAM0), Sipeed SDRAM module (W9825G6KH-6). Pin
// numbers are the connector's; DQ and DQM order as the module wires them.
IO_LOC "sdram_clk" B17;      // 20
IO_LOC "sdram_cs_n" F21;     // 33
IO_LOC "sdram_ras_n" F16;    // 32
IO_LOC "sdram_cas_n" E17;    // 31

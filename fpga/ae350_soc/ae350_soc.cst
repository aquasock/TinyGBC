IO_LOC "sdram_a[4]" E16;     // 28
IO_LOC "sdram_a[5]" D15;     // 25
IO_LOC "sdram_a[6]" D14;     // 26
IO_LOC "sdram_a[7]" A19;     // 23
IO_LOC "sdram_a[8]" A18;     // 24
IO_LOC "sdram_a[9]" C17;     // 21
IO_LOC "sdram_a[10]" D20;    // 36
IO_LOC "sdram_a[11]" D17;    // 22
IO_LOC "sdram_a[12]" B18;    // 19
IO_LOC "sdram_dqm[0]" F14;   // 29
IO_LOC "sdram_dqm[1]" F13;   // 30
IO_LOC "sdram_dq[0]" E14;    // 1
IO_LOC "sdram_dq[1]" E13;    // 2
IO_LOC "sdram_dq[2]" C15;    // 3
IO_LOC "sdram_dq[3]" C14;    // 4
IO_LOC "sdram_dq[4]" B13;    // 5
